{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FastSeek",
  "version": "0.1.0",
  "identifier": "com.fastseek.app",
  "build": {
    "frontendDist": "../tauri-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FastSeek",
        "width": 900,
        "height": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
