<Window x:Class="FastSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760"
        Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
  <Border CornerRadius="18"
          BorderBrush="#33FFFFFF"
          BorderThickness="1"
          Background="#EE17191E"
          Padding="0">
    <Border.Effect>
      <DropShadowEffect BlurRadius="46" ShadowDepth="18" Opacity="0.45" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="78" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBox x:Name="SearchBox"
               Grid.Row="0"
               BorderThickness="0"
               Background="#11FFFFFF"
               Foreground="#F6F7FB"
               CaretBrush="#F6F7FB"
               FontFamily="Segoe UI"
               FontSize="30"
               FontWeight="SemiBold"
               Padding="28,16"
               VerticalContentAlignment="Center"
               TextChanged="SearchBox_TextChanged"
               PreviewKeyDown="SearchBox_PreviewKeyDown" />
      <TextBlock x:Name="StatusText"
                 Grid.Row="1"
                 Foreground="#99F6F7FB"
                 FontSize="14"
                 Margin="28,16,28,8" />
      <ListBox x:Name="ResultsList"
               Grid.Row="2"
               Margin="8"
               BorderThickness="0"
               Background="Transparent"
               Foreground="#F6F7FB"
               MouseDoubleClick="ResultsList_MouseDoubleClick"
               PreviewKeyDown="ResultsList_PreviewKeyDown"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="#2F7DF6" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Height="58" Margin="14,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="36" Height="36" CornerRadius="9" Background="#22FFFFFF">
                <TextBlock Text="{Binding KindText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Path}" FontSize="13" Foreground="#99F6F7FB" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</Window>
